{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/route.ts",
    "app/**/loading.tsx",
    "app/**/error.tsx",
    "app/**/not-found.tsx",
    "app/**/template.tsx",
    "app/**/default.tsx",
    "app/**/opengraph-image.tsx",
    "app/**/icon.tsx",
    "app/**/apple-icon.tsx",
    "app/**/sitemap.ts",
    "app/**/robots.ts",
    "app/**/manifest.ts",
    "middleware.ts",
    "instrumentation.ts",
    "instrumentation-client.ts",
    "sentry.server.config.ts",
    "sentry.edge.config.ts",
    "next.config.mjs",
    "postcss.config.mjs",
    "emails/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "__tests__/**/*.test.{ts,tsx}",
    "**/*.test.{ts,tsx}"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "contexts/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "services/**/*.{ts,tsx}",
    "types/**/*.{ts,tsx}",
    "utils/**/*.{ts,tsx}",
    "emails/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "__tests__/**/*.{ts,tsx}",
    "middleware.ts",
    "instrumentation.ts",
    "instrumentation-client.ts",
    "sentry.*.config.ts",
    "next.config.mjs",
    "postcss.config.mjs"
  ],
  "ignore": [
    ".next/**",
    "coverage/**",
    "public/**",
    "styles/**",
    "supabase/**",
    "tests/**",
    "tsconfig.tsbuildinfo",
    "schema_dump.md",
    "*.md"
  ],
  "ignoreDependencies": [
    "autoprefixer",
    "postcss-load-config"
  ]
}
