# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored deliberately: a leading slash matches the repo root only, so a
# nested node_modules (a tool run from the wrong cwd writes one) stays visible
# to `git add -A`. No tracked path lives under a node_modules segment.
node_modules/

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# supabase CLI transient metadata (project ref, pooler url, version pins)
supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Sentry Config File
.env.sentry-build-plugin

# macOS
.DS_Store
**/.DS_Store

# Claude Code tool-internal artifacts (plans, per-project memory)
.claude/plans/
.claude/projects/
scratchpad/
